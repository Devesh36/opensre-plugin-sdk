"""HTTP client for {{ class_prefix }} API."""

from __future__ import annotations

from typing import Any

import httpx


class {{ class_prefix }}Client:
    """Minimal client stub — replace with your vendor API calls."""

    def __init__(self, *, api_key: str, base_url: str = "https://api.example.com") -> None:
        self._api_key = api_key
        self._base_url = base_url.rstrip("/")

    def search(self, query: str) -> dict[str, Any]:
        if not self._api_key:
            return {"error": "{{ class_prefix }} API key is not configured"}
        try:
            response = httpx.get(
                f"{self._base_url}/search",
                params={"q": query},
                headers={"Authorization": f"Bearer {self._api_key}"},
                timeout=30.0,
            )
            response.raise_for_status()
            return {"success": True, "results": response.json()}
        except httpx.HTTPError as exc:
            return {"error": f"{{ class_prefix }} API request failed: {exc}"}
