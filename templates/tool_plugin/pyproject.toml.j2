[project]
name = "{{ plugin_name }}"
version = "0.1.0"
description = "{{ class_prefix }} investigation tools for OpenSRE"
requires-python = ">=3.12"
dependencies = [
    "opensre-plugin-sdk>=0.1",
    "httpx>=0.27",
]

[project.optional-dependencies]
dev = ["pytest>=8", "pytest-httpx>=0.30"]

[tool.opensre-plugin]
name = "{{ name }}"
tools_package = "{{ plugin_name }}.tools"
description = "{{ class_prefix }} tools for OpenSRE investigations"

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"
